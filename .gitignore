# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# Python / Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
venv/
ENV/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
backend/staticfiles/
backend/media/

# Node / Angular
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Backups (NEVER COMMIT RAW DUMPS)
*.sql.gz
*.dump
*.bak
*.sqlite3
ops/backups/

# IDEs & OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
.DS_Store