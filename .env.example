# ============================================================================
# PBMS SaaS - Environment Variables Template (PLACEHOLDERS ONLY)
# Copy this file to backend/.env and replace placeholders with local values.
# NEVER commit your actual .env file to Git.
# ============================================================================

# Django Core Settings
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-secure-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
POSTGRES_DB=pbms_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# JWT & Session Security
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=replace-with-separate-jwt-signing-secret-key

# CORS Allowed Origins (Three Separate Angular Frontends)
# Frontend A: Super Admin (4201)
# Frontend B: Tenant Workspace (4202)
# Frontend C: Public Website (4200)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# Backup Configuration
BACKUP_OUTPUT_DIR=C:/Projects/pbms-saas/ops/backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_PASSPHRASE_ENV=PBMS_BACKUP_PASSPHRASE