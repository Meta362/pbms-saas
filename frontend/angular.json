            "browser": "projects/super-admin/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/super-admin/tsconfig.app.json",
            "styles": ["projects/super-admin/src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": false
              },
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 4201
          },
          "configurations": {
            "production": {
              "buildTarget": "super-admin:build:production"
            },
            "development": {
