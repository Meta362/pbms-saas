            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "tenant-workspace": {
      "projectType": "application",
      "root": "projects/tenant-workspace",
      "sourceRoot": "projects/tenant-workspace/src",
      "prefix": "pbms-tenant",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/tenant-workspace",
            "index": "projects/tenant-workspace/src/index.html",
            "browser": "projects/tenant-workspace/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/tenant-workspace/tsconfig.app.json",
            "styles": ["projects/tenant-workspace/src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
