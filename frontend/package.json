{
  "name": "pbms-frontend-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start:public": "ng serve public-site --port 4200",
    "start:admin": "ng serve super-admin --port 4201",
    "start:tenant": "ng serve tenant-workspace --port 4202",
    "build:public": "ng build public-site --configuration production",
    "build:admin": "ng build super-admin --configuration production",
    "build:tenant": "ng build tenant-workspace --configuration production",
    "build:all": "npm run build:public && npm run build:admin && npm run build:tenant",
    "test:helpers": "node --test --experimental-strip-types tests/session-recovery.test.ts",
    "test:real": "npx esbuild tests/real-session-regression.test.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/test-suite.mjs && node --test dist/test-suite.mjs",
    "test": "npm run test:helpers && npm run test:real"
  },
  "dependencies": {
    "@angular/animations": "19.2.0",
    "@angular/common": "19.2.0",
    "@angular/compiler": "19.2.0",
    "@angular/core": "19.2.0",
    "@angular/forms": "19.2.0",
    "@angular/platform-browser": "19.2.0",
    "@angular/platform-browser-dynamic": "19.2.0",
    "@angular/router": "19.2.0",
    "rxjs": "7.8.1",
    "tslib": "2.8.1",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.2.0",
    "@angular/cli": "19.2.0",
    "@angular/compiler-cli": "19.2.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
